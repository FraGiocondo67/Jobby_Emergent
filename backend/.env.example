# Backend JOBBY — variabili d'ambiente.
# Questo file NON esisteva prima del Blocco 1 (su Emergent, MONGO_URL/DB_NAME/
# EXPO_PUBLIC_BACKEND_URL erano iniettate dalla piattaforma). Copia questo file
# in `.env` e compila i valori reali — non committare mai `.env`.

# --- Mongo (BLOCCO 7: ora OPZIONALE) ---
# Dal Blocco 6 le 4 verticali + business/listino/spec4/disputes/chat/
# notifications/provider_onboarding/geo/stripe_connect sono tutte Postgres —
# non serve più MongoDB per farle funzionare. Restano Mongo-based solo 8
# router "storici" mai migrati (wallet.py, admin_web.py, admin_auth.py,
# payments_stripe.py, payments_services.py, payments_paypal.py,
# catalog_routes.py, dashboard.py) — verificato che il server si avvia e
# risponde comunque senza queste variabili (client Mongo lazy, vedi core.py);
# solo le chiamate reali a quei router specifici falliranno con un timeout.
# Impostale solo se vuoi tenerli in vita puntandoli a un'istanza reale.
MONGO_URL=
DB_NAME=

# --- Supabase / Postgres (nuove, Blocco 1) ---
# URL e service role key del progetto Supabase JOBBY storico (axiemfglsjknecvwtypm).
# La service role key si trova in Supabase Dashboard -> Project Settings -> API.
# NON esporla mai al client (mobile/web) — solo il backend la usa.
SUPABASE_URL=https://axiemfglsjknecvwtypm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (invariata) ---
ADMIN_TOKEN=

# --- Pagamenti (Stripe e PayPal attivi da subito; YOB Pay è sviluppo futuro) ---
STRIPE_API_KEY=
STRIPE_CONNECT_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE=

# --- AI dispute arbitration (Blocco 4) ---
# Chiave Anthropic propria JOBBY — sostituisce EMERGENT_LLM_KEY (vedi sotto).
# Senza questa chiave dispute_ai.py usa comunque il fallback euristico, senza
# errori (vedi ai_analyze() in dispute_ai.py).
ANTHROPIC_API_KEY=
# Opzionale — default "claude-sonnet-5" se non impostata.
ANTHROPIC_MODEL=

# --- Rimosse rispetto alla versione Emergent (non servono più) ---
# EMERGENT_SESSION_URL   -> sostituita da Supabase Auth (Google OAuth nativo)
# EMERGENT_LLM_KEY       -> sostituita da ANTHROPIC_API_KEY nel Blocco 4
